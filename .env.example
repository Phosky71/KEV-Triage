# ============================================================================
# CONFIGURACIÓN DE CLIENTE (FRONTEND VITE)
# ¡IMPORTANTE! Nunca coloques claves secretas ni tokens privados en variables VITE_*
# ============================================================================

# Opción A: Conexión a través del proxy local seguro (Recomendado si Kev requiere API Key)
# VITE_MODAL_API_URL=http://localhost:8787/api/kev

# Opción B: Conexión directa al despliegue en Modal (Solo si el endpoint gestiona CORS y no exige secreto en cliente)
VITE_MODAL_API_URL=https://TU_USUARIO--kev-api.modal.run

# Identificador del modelo Kev configurado en el servidor (ej. kev-small, kev-base, Qwen/Qwen2.5-1.5B-Instruct, etc.)
VITE_KEV_MODEL=kev-default

# ============================================================================
# CONFIGURACIÓN DEL PROXY BACKEND OPCIONAL (server/proxy.mjs)
# Estas variables NUNCA se exponen al navegador.
# ============================================================================
PORT=8787
KEV_UPSTREAM_URL=https://TU_USUARIO--kev-api.modal.run
KEV_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173